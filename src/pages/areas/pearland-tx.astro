---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBar from '../../components/TrustBar.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTABand from '../../components/CTABand.astro';
import LeadForm from '../../components/LeadForm.astro';
import SchemaHead from '../../components/SchemaHead.astro';
import { services } from '../../data/services';
import { areas } from '../../data/areas';

const area = areas.find(a => a.slug === 'pearland-tx')!;
const nearby = areas.filter(a => area.nearbyAreas.includes(a.slug));
---

<BaseLayout
  title={`Septic Tank Service in ${area.fullName} | Pumping & Repair`}
  description={`Explore septic pumping, repair, installation, inspection, and maintenance options for ${area.fullName} and ${area.county} County property owners.`}
  canonicalPath={`/areas/${area.slug}/`}
>
  <SchemaHead type="FAQPage" faqs={area.faqs} />

  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Service Areas', href: '/service-areas/' }, { name: area.name }]} />

  <Hero
    h1={`Septic Tank Service in ${area.fullName}`}
    lead={`Professional septic tank repair, pumping, installation, and inspection in ${area.fullName}. Serving ${area.county} County with same-day service and 24/7 emergency response.`}
  />
  <TrustBar />

  <section class="section">
    <div class="container">
      <h2>Septic Systems in {area.name}</h2>
      <p>{area.localContext}</p>
      <p><strong>ZIP codes covered:</strong> {area.zipCodes.join(', ')}</p>
    </div>
  </section>

  <section class="section bg-light">
    <div class="container">
      <h2>Septic Tank Pumping in {area.name}</h2>
      <p>Pearland's rapid growth into formerly rural areas of Brazoria, Fort Bend, and Harris Counties means many septic systems are serving homes on properties that were once farmland. Regular pumping every 3 to 5 years prevents solids from overwhelming drain fields in the area's Gulf Coast soils. Our crews cover all Pearland ZIP codes — 77581, 77584, and 77588 — with same-day service available for calls received before noon.</p>
      <a href="/services/septic-pumping/" class="btn-hero" style="display:inline-block;">More on Septic Tank Pumping</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Septic Tank Repair in {area.name}</h2>
      <p>Properties on the southern and western edges of Pearland sit on clay-heavy Gulf Coast soils that shift with seasonal moisture changes, which can crack tank walls and separate pipe connections over time. We handle baffle repair, distribution box replacement, drain field rehabilitation, and line jetting across all three counties that make up Pearland. Our technicians document every repair with photos and explain exactly what needs fixing before any work begins.</p>
      <a href="/services/septic-repair/" class="btn-hero" style="display:inline-block;">More on Septic Tank Repair</a>
    </div>
  </section>

  <section class="section bg-light">
    <div class="container">
      <h2>Septic Tank Installation in {area.name}</h2>
      <p>As Pearland continues to expand into Brazoria, Fort Bend, and Harris County land, new construction on the city's edges often requires private septic systems. We design and install systems that meet the specific permitting requirements for whichever county jurisdiction covers your address. From soil evaluation and percolation testing through permit approval and final inspection, we handle every step of the installation process.</p>
      <a href="/services/septic-installation/" class="btn-hero" style="display:inline-block;">More on Septic Tank Installation</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Septic Tank Inspection in {area.name}</h2>
      <p>Whether you are buying or selling a home in Pearland or need a routine system evaluation, our inspections cover the full assessment — tank condition, baffle integrity, sludge levels, drain field function, and distribution box health. Pearland straddles three counties, and we format all reports to meet the specific requirements of Brazoria County Environmental Health, Fort Bend County, or Harris County Public Health depending on your address. Written reports with photos are delivered within 48 hours.</p>
      <a href="/services/septic-inspection/" class="btn-hero" style="display:inline-block;">More on Septic Tank Inspection</a>
    </div>
  </section>

  <section class="section bg-light">
    <div class="container">
      <h2>Septic Tank Maintenance in {area.name}</h2>
      <p>Pearland's mix of sandy and clay soils across three counties creates variable conditions that make regular professional maintenance critical for septic longevity. Our maintenance visits include sludge measurement, baffle inspection, effluent filter cleaning, and a drain field evaluation, all documented with a written report and recommendations. Preventive maintenance every 1 to 2 years helps Pearland homeowners catch small problems before they become expensive emergencies.</p>
      <a href="/services/septic-maintenance/" class="btn-hero" style="display:inline-block;">More on Septic Tank Maintenance</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Emergency Septic Service in {area.name}</h2>
      <p>A sewage backup or system failure in your Pearland home requires immediate attention, not a callback tomorrow. We provide 24/7 emergency septic service throughout Pearland with dispatch typically within 90 to 120 minutes across all three county jurisdictions. Our emergency crews carry the equipment to diagnose and address the most common urgent septic problems on the first visit, keeping your family safe and your home clean.</p>
      <a href="/services/emergency-septic/" class="btn-hero" style="display:inline-block;">More on Emergency Septic Service</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Services Available in {area.name}</h2>
      <div class="grid grid-3">
        {services.map(s => (
          <ServiceCard slug={s.slug} name={s.name} icon={s.icon} />
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-light">
    <div class="container">
      <h2>Nearby Service Areas</h2>
      <div class="chips">
        {nearby.map(n => (
          <a href={`/areas/${n.slug}/`} class="chip">Septic Service in {n.fullName}</a>
        ))}
        <a href="/service-areas/" class="chip">View All Service Areas</a>
      </div>
    </div>
  </section>

  <FAQSection heading={`Septic Service Questions for ${area.name}`} faqs={area.faqs} />

  <section class="section">
    <div class="container" style="max-width:600px;">
      <LeadForm />
    </div>
  </section>

  <CTABand heading={`Need Septic Service in ${area.name}?`} text="Licensed, insured, and available 24/7 for emergencies. Free estimates." />
</BaseLayout>
