---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBar from '../../components/TrustBar.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTABand from '../../components/CTABand.astro';
import LeadForm from '../../components/LeadForm.astro';
import SchemaHead from '../../components/SchemaHead.astro';
import { services } from '../../data/services';
import { areas } from '../../data/areas';

const area = areas.find(a => a.slug === 'sugar-land-tx')!;
const nearby = areas.filter(a => area.nearbyAreas.includes(a.slug));
---

<BaseLayout
  title={`Septic Tank Service in ${area.fullName} | Pumping & Repair`}
  description={`Professional septic tank service in ${area.fullName}. Pumping, repair, installation, and inspection. ${area.county} County. Licensed and insured. Free estimates.`}
  canonicalPath={`/areas/${area.slug}/`}
>
  <SchemaHead type="LocalBusiness" data={{ areaServed: area.fullName }} />
  <SchemaHead type="FAQPage" faqs={area.faqs} />

  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Service Areas', href: '/service-areas/' }, { name: area.name }]} />

  <Hero
    h1={`Septic Tank Service in ${area.fullName}`}
    lead={`Professional septic tank repair, pumping, installation, and inspection in ${area.fullName}. Serving ${area.county} County with same-day service and 24/7 emergency response.`}
  />
  <TrustBar />

  <section class="section">
    <div class="container">
      <h2>Septic Systems in {area.name}</h2>
      <p>{area.localContext}</p>
      <p><strong>ZIP codes covered:</strong> {area.zipCodes.join(', ')}</p>
    </div>
  </section>

  <section class="section bg-light">
    <div class="container">
      <h2>Septic Tank Pumping in {area.name}</h2>
      <p>Sugar Land properties near the Brazos River floodplain in Fort Bend County face higher water tables that can affect how quickly solids accumulate in the tank. Routine pumping every 3 to 5 years prevents solids from migrating into the drain field and causing saturation. We service all Sugar Land ZIP codes — 77478, 77479, and 77498 — with same-day scheduling available for most addresses.</p>
      <a href="/services/septic-pumping/" class="btn-hero" style="display:inline-block;">More on Septic Tank Pumping</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Septic Tank Repair in {area.name}</h2>
      <p>Fort Bend County clay soils put consistent pressure on septic tanks and pipe connections in Sugar Land, and the proximity to the Brazos River means some properties deal with saturated drain fields that need rehabilitation. We handle baffle repair, distribution box replacement, line jetting, and drain field restoration across all Sugar Land addresses. Our technicians document every repair with photos so you see exactly what was fixed and why.</p>
      <a href="/services/septic-repair/" class="btn-hero" style="display:inline-block;">More on Septic Tank Repair</a>
    </div>
  </section>

  <section class="section bg-light">
    <div class="container">
      <h2>Septic Tank Installation in {area.name}</h2>
      <p>Properties on the western and southern edges of Sugar Land — particularly near the Brazos River floodplain — often require engineered septic systems due to high water tables and Fort Bend County clay soils. We design and install systems that meet Fort Bend County Environmental Health requirements, including aerobic treatment units where conventional gravity systems are not viable. From permit to final inspection, we handle the entire installation process.</p>
      <a href="/services/septic-installation/" class="btn-hero" style="display:inline-block;">More on Septic Tank Installation</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Septic Tank Inspection in {area.name}</h2>
      <p>Sugar Land homebuyers and sellers benefit from professional septic inspection, especially for properties on the edges of the city where municipal sewer has not reached. Our inspections evaluate tank condition, baffle integrity, sludge levels, and drain field performance, with all reporting formatted to Fort Bend County Environmental Health standards. Written reports with photos are delivered within 48 hours for real estate transactions or routine health checks.</p>
      <a href="/services/septic-inspection/" class="btn-hero" style="display:inline-block;">More on Septic Tank Inspection</a>
    </div>
  </section>

  <section class="section bg-light">
    <div class="container">
      <h2>Septic Tank Maintenance in {area.name}</h2>
      <p>Sugar Land's Fort Bend County clay soils and the variable water conditions near the Brazos River make preventive maintenance especially valuable for extending septic system life. Our maintenance visits include sludge measurement, baffle inspection, effluent filter cleaning, and a drain field walk-through — all documented with a written report. Regular professional maintenance every 1 to 2 years helps Sugar Land homeowners stay ahead of the soil and water table challenges unique to the area.</p>
      <a href="/services/septic-maintenance/" class="btn-hero" style="display:inline-block;">More on Septic Tank Maintenance</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Emergency Septic Service in {area.name}</h2>
      <p>When a septic backup or overflow hits your Sugar Land home, you need service fast — not next week. We dispatch emergency crews across all Sugar Land ZIP codes within 90 to 120 minutes, 24 hours a day, 7 days a week. Our emergency trucks carry the equipment to diagnose and address the most common urgent septic failures on the first visit in Fort Bend County.</p>
      <a href="/services/emergency-septic/" class="btn-hero" style="display:inline-block;">More on Emergency Septic Service</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Services Available in {area.name}</h2>
      <div class="grid grid-3">
        {services.map(s => (
          <ServiceCard slug={s.slug} name={s.name} icon={s.icon} />
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-light">
    <div class="container">
      <h2>Nearby Service Areas</h2>
      <div class="chips">
        {nearby.map(n => (
          <a href={`/areas/${n.slug}/`} class="chip">Septic Service in {n.fullName}</a>
        ))}
        <a href="/service-areas/" class="chip">View All Service Areas</a>
      </div>
    </div>
  </section>

  <FAQSection heading={`Septic Service Questions for ${area.name}`} faqs={area.faqs} />

  <section class="section">
    <div class="container" style="max-width:600px;">
      <LeadForm />
    </div>
  </section>

  <CTABand heading={`Need Septic Service in ${area.name}?`} text="Licensed, insured, and available 24/7 for emergencies. Free estimates." />
</BaseLayout>
