---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<BaseLayout title="Terms of Service | Septic Tank Repair Houston" description="Read the terms that govern use of the Septic Tank Repair Houston website, content, and service-request forms." canonicalPath="/terms/">
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Terms of Service' }]} />
  <section class="section">
    <div class="container" style="max-width:800px;">
      <h1>Terms of Service</h1>
      <p><strong>Last updated:</strong> July 2025</p>
      <p>By using the Septic Tank Repair Houston website and services, you agree to the following terms.</p>

      <h2>Services</h2>
      <p>Septic Tank Repair Houston provides septic tank repair, pumping, installation, inspection, maintenance, and emergency service in the Houston, TX metro area. All services are subject to availability.</p>

      <h2>Pricing</h2>
      <p>Prices quoted on our website or over the phone are estimates. Final pricing is confirmed on-site after inspection. We will notify you of any price changes before performing additional work.</p>

      <h2>Warranties</h2>
      <p>Service warranties vary by work type and are communicated at the time of service. Contact us for specific warranty details.</p>

      <h2>Limitation of Liability</h2>
      <p>Septic Tank Repair Houston is not liable for damages resulting from delayed service, pre-existing system conditions, or circumstances beyond our control.</p>

      <h2>Contact</h2>
      <p>Questions about these terms? Contact us through our <a href="/contact/">contact page</a>.</p>
    </div>
  </section>
</BaseLayout>
