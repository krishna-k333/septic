---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LeadForm from '../components/LeadForm.astro';
import SchemaHead from '../components/SchemaHead.astro';
---
<BaseLayout
  title="Request Septic Service in Houston | Repair & Pumping"
  description="Request septic pumping, repair, inspection, installation, or urgent service in greater Houston. Get started with a free estimate."
  canonicalPath="/contact/"
>
  <SchemaHead type="ContactPage" data={{ name: "Request Septic Service in Houston" }} />

  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Contact' }]} />

  <section class="hero page-hero">
    <div class="container">
      <p class="eyebrow"><span aria-hidden="true"></span>Houston-area requests</p>
      <h1>Tell us what your septic system is doing.</h1>
      <p class="lead">Share the essential details so the service need, location, and timing are clear from the start.</p>
    </div>
  </section>

  <section class="section form-section">
    <div class="container form-layout">
      <div class="form-side">
        <span class="section-label">Before you submit</span>
        <h2>Useful details make the next conversation easier.</h2>
        <ul class="plain-checks">
          <li><span aria-hidden="true">✓</span> Your city or ZIP code</li>
          <li><span aria-hidden="true">✓</span> The warning signs you noticed</li>
          <li><span aria-hidden="true">✓</span> When the issue started</li>
        </ul>
      </div>
      <LeadForm heading="Start your request" />
    </div>
  </section>
</BaseLayout>
