---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import FAQSection from '../components/FAQSection.astro';
import CTABand from '../components/CTABand.astro';
import SchemaHead from '../components/SchemaHead.astro';
import { services } from '../data/services';

const serviceDescriptions: Record<string, string> = {
  'septic-pumping': 'Routine tank pumping requests for homes and commercial properties.',
  'septic-repair': 'Help for backups, damaged components, line issues, and field concerns.',
  'septic-installation': 'Requests involving replacement systems, new builds, and permitting.',
  'septic-inspection': 'System checks for ownership decisions, maintenance, or troubleshooting.',
  'septic-maintenance': 'Preventive service requests to help keep a system working as intended.',
  'emergency-septic': 'Urgent request routing for active backups, overflow, or system failure.',
};

const homepageFaqs = [
  {
    question: 'What information should I include in a septic service request?',
    answer: 'Include your city, the warning signs you have noticed, when the issue started, and whether wastewater is backing up inside. If you know the system type or last pumping date, add that too.',
  },
  {
    question: 'What should I do if sewage is backing up?',
    answer: 'Stop using water in the property, keep people and pets away from wastewater, and do not open or enter the tank. Submit an urgent service request and clearly describe where the backup is appearing.',
  },
  {
    question: 'Which septic services can I request?',
    answer: 'You can request septic pumping, repair, inspection, maintenance, installation, and help with an urgent backup or overflow.',
  },
  {
    question: 'How much does septic service cost in Houston?',
    answer: 'Cost depends on the system, tank access, service type, and what the inspection finds. Share the issue first, then confirm the scope and written estimate before work begins.',
  },
  {
    question: 'Which Houston-area communities are covered?',
    answer: 'The website accepts requests from Houston and surrounding communities including Katy, Sugar Land, Pearland, The Woodlands, Cypress, Spring, Conroe, Baytown, Humble, and Tomball.',
  },
];

const processSteps = [
  { name: 'Tell us what is happening', text: 'Choose the closest service and share your city, warning signs, and timing.' },
  { name: 'Schedule the right service', text: 'Use those details to confirm the service type, timing, and what happens next.' },
  { name: 'Get your system handled', text: 'Review the scope and estimate, then move forward with the work you need.' },
];
---
<BaseLayout
  title="Septic Service Requests in Houston, TX | Repair & Pumping"
  description="Septic pumping, repair, inspection, installation, and emergency service across greater Houston. Request a free estimate."
  canonicalPath="/"
>
  <SchemaHead type="WebSite" />
  <SchemaHead type="Organization" />
  <SchemaHead type="FAQPage" faqs={homepageFaqs} />
  <SchemaHead type="HowTo" data={{ name: 'How to Request Septic Service in Houston' }} howToSteps={processSteps} />

  <Hero
    h1="Houston septic problems, handled the right way."
    lead="From routine pumping to urgent backups, get the right septic service for your property with a clear process and straightforward next steps."
    showForm
  />
  <TrustBar />

  <section class="section services-section">
    <div class="container">
      <div class="section-head">
        <span class="section-label">Choose your service path</span>
        <h2>What does your septic system need?</h2>
        <p>Start with the closest match. If you are unsure, the request form lets you say that.</p>
      </div>
      <div class="grid grid-3">
        {services.map(service => (
          <ServiceCard
            slug={service.slug}
            name={service.name}
            icon={service.icon}
            description={serviceDescriptions[service.slug]}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section signal-section">
    <div class="container signal-layout">
      <div>
        <span class="section-label">Know when to act</span>
        <h2>Small warning signs can point to a larger septic issue.</h2>
        <p>One slow drain may be plumbing. Multiple slow drains, wastewater odors, gurgling fixtures, wet ground over the system, or an indoor backup can indicate a septic problem.</p>
        <a href="/blog/signs-septic-tank-needs-repair/" class="text-link">Review common warning signs <span aria-hidden="true">→</span></a>
      </div>
      <div class="signal-list">
        <div><span aria-hidden="true">01</span><p><strong>Stop water use</strong> if wastewater is backing up indoors.</p></div>
        <div><span aria-hidden="true">02</span><p><strong>Keep people and pets away</strong> from pooling wastewater.</p></div>
        <div><span aria-hidden="true">03</span><p><strong>Do not open the tank.</strong> Confined-space gases can be dangerous.</p></div>
      </div>
    </div>
  </section>

  <section class="section process-section" id="how-it-works">
    <div class="container">
      <div class="section-head section-head-left">
        <span class="section-label">Simple from start to finish</span>
        <h2>From septic problem to a working system.</h2>
      </div>
      <ol class="process-grid">
        {processSteps.map((step, index) => (
          <li class="process-card">
            <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.name}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ServiceAreas heading="Request septic service across greater Houston" />

  <FAQSection heading="Questions before you request service" faqs={homepageFaqs} />
  <CTABand heading="Ready to get your septic system handled?" text="Describe the issue and get started with the right Houston-area septic service." />
</BaseLayout>
