const blogImage = '/images/blog/septic-pumping-vs-cleaning.webp';

const blogFaqs = [
  {
    question: 'What is the difference between septic pumping and septic cleaning?',
    answer: 'The labels are not standardized. A proper pump-out removes accumulated material and should include basic condition observations. Some companies use cleaning for extra washing or filter work, so ask for the written scope.',
  },
  {
    question: 'How much more does cleaning cost than pumping?',
    answer: 'There is no standard surcharge because companies define cleaning differently. Compare written scopes rather than comparing the labels alone.',
  },
  {
    question: 'How often should I get a full cleaning vs just pumping?',
    answer: 'Do not use an automatic every-other-pump rule. Ask what the inspection found and approve extra work only when the tank condition, filter, or components justify it.',
  },
  {
    question: 'Does cleaning remove more waste than pumping?',
    answer: 'It may, depending on the process, but a spotless-looking tank is not the goal. The useful questions are whether accumulated solids were removed and whether the tank, outlet, filter, and drainfield showed problems.',
  },
];

const howToSteps = [
  { name: 'Pumping', text: 'A vacuum hose is inserted into the tank. Liquid effluent and settled sludge are sucked out and hauled to a disposal facility.' },
  { name: 'Confirm Added Work', text: 'Ask the provider to list any filter service, rinsing, inspection, or documentation included beyond solids removal.' },
  { name: 'Baffle Inspection', text: 'The inlet and outlet baffles are visually inspected for cracks, deterioration, or blockages.' },
  { name: 'Filter Cleaning', text: 'If the system has an effluent filter, it is removed, cleaned, and reinstalled.' },
  { name: 'Report', text: 'You receive a written report with findings, photos, and recommendations.' },
