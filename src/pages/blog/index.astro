---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';

const posts = [
  { slug: 'septic-pumping-cost-houston', title: 'Houston Septic Pumping Cost: Complete 2026 Guide', excerpt: 'Six factors that change a pumping quote, plus a practical checklist for comparing the same scope across providers.' },
  { slug: 'how-often-pump-septic-tank-texas', title: 'How Often Should You Pump a Septic Tank in Texas?', excerpt: 'The 3-to-5-year guideline, the household factors that change it, and why inspection records beat a guessed date.' },
  { slug: 'signs-septic-tank-needs-repair', title: 'Signs Your Septic Tank Needs Repair', excerpt: 'Seven observable warning signs, what they may mean, and the safe next step when several appear together.' },
  { slug: 'septic-pumping-vs-cleaning', title: 'Septic Pumping vs Cleaning: What Is the Difference?', excerpt: 'Why service labels vary and which written details make two septic quotes genuinely comparable.' },
  { slug: 'texas-septic-tank-regulations', title: 'Texas Septic Rules for Houston Homeowners', excerpt: 'How TCEQ rules, local authorized agents, permits, licensing roles, and property transactions fit together.' },
  { slug: 'emergency-septic-what-to-do', title: 'Emergency Septic Problems: What to Do Before Help Arrives', excerpt: 'Six immediate steps for reducing wastewater flow, limiting exposure, and giving a technician useful information.' },
  { slug: 'how-to-choose-septic-company-houston', title: 'How to Choose a Septic Company in Houston', excerpt: 'Eight questions for verifying credentials, comparing written scopes, and spotting pressure before approving work.' },
  { slug: 'hurricane-season-septic-system-houston', title: 'Hurricane Season and Your Septic System in Houston', excerpt: 'CDC-backed precautions for septic tanks, drainfields, electrical components, and water use around flooding.' },
];
---
<BaseLayout
  title="Septic Tank Blog | Houston Tips & Guides"
  description="Explore 8 practical septic guides for Houston homeowners, covering pumping schedules, repair signs, costs, Texas rules, emergencies, and storm preparation."
  canonicalPath="/blog/"
>
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Blog' }]} />

  <section class="hero" style="padding:2.5rem 0;">
    <div class="container">
      <h1>Septic Tank Blog</h1>
      <p class="lead">Expert tips and guides for Houston homeowners on septic tank repair, pumping, maintenance, and more.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="blog-grid">
        {posts.map(post => (
          <article class="blog-card">
            <a href={`/blog/${post.slug}/`} aria-label={`Read ${post.title}`}>
              <img
                src={`/images/blog/${post.slug}-720.webp`}
                srcset={`/images/blog/${post.slug}-720.webp 720w, /images/blog/${post.slug}.webp 1200w`}
                sizes="(max-width: 640px) calc(100vw - 2rem), (max-width: 980px) calc(50vw - 2rem), 360px"
                alt=""
                width="1200"
                height="800"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="blog-card-copy">
              <h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2>
              <p>{post.excerpt}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTABand heading="Need Septic Service in Houston?" text="Share the property details and the service you need to request an estimate." />
</BaseLayout>
