---
import { services } from '../data/services';
import { areas } from '../data/areas';
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h4>Septic Tank Repair Houston</h4>
        <p>Professional septic tank repair, pumping, installation, and inspection services across Houston, TX and surrounding communities. Licensed and insured. 24/7 emergency service available.</p>
      </div>
      <div>
        <h4>Services</h4>
        <ul>
          {services.map(s => (
            <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Service Areas</h4>
        <ul>
          {areas.map(a => (
            <li><a href={`/areas/${a.slug}/`}>{a.fullName}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/about/">About Us</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Service</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Septic Tank Repair Houston. All rights reserved. Serving Harris, Fort Bend, Montgomery, and surrounding counties.</p>
    </div>
  </div>
</footer>
