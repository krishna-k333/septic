---
import { services } from '../data/services';
import { areas } from '../data/areas';
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <p class="footer-heading">Septic Tank Repair Houston</p>
        <p>Septic repair, pumping, installation, inspection, and maintenance across Houston and surrounding communities.</p>
      </div>
      <div>
        <p class="footer-heading">Services</p>
        <ul>
          {services.map(s => (
            <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="footer-heading">Service Areas</p>
        <ul>
          {areas.map(a => (
            <li><a href={`/areas/${a.slug}/`}>{a.fullName}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="footer-heading">Company</p>
        <ul>
          <li><a href="/about/">About Us</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Service</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Septic Tank Repair Houston. All rights reserved.</p>
    </div>
  </div>
</footer>
