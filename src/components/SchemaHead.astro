---
import { site } from '../data/site';

interface Props {
  type: 'WebSite' | 'Organization' | 'FAQPage' | 'Service' | 'HowTo' | 'AboutPage' | 'ContactPage' | 'CollectionPage' | 'BlogPosting';
  data?: Record<string, any>;
  faqs?: { question: string; answer: string }[];
  howToSteps?: { name: string; text: string }[];
  blogTitle?: string;
  blogDate?: string;
  blogModified?: string;
  blogDescription?: string;
  blogImage?: string;
}

const {
  type,
  data = {},
  faqs,
  howToSteps,
  blogTitle,
  blogDate,
  blogModified,
  blogDescription,
  blogImage,
} = Astro.props;

let schemas: any[] = [];

if (type === 'WebSite') {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": site.name,
    "url": site.domain,
    ...data,
  });
}

if (type === 'Organization') {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": site.name,
    "url": site.domain,
    ...data,
  });
}

if (type === 'Service') {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": data.serviceType || "Septic Service",
    "areaServed": { "@type": "City", "name": "Houston", "containedInPlace": { "@type": "State", "name": "Texas" } },
    ...data,
  });
}

if (type === 'HowTo' && howToSteps) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": data.name || "Septic Service Process",
    "step": howToSteps.map((s, i) => ({
      "@type": "HowToStep",
      "position": i + 1,
      "name": s.name,
      "text": s.text,
    })),
  });
}

if (type === 'BlogPosting') {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": blogTitle,
    "author": { "@type": "Organization", "name": site.author },
    "publisher": { "@type": "Organization", "name": site.name, "url": site.domain },
    "datePublished": blogDate,
    "dateModified": blogModified || blogDate,
    ...(blogDescription ? { "description": blogDescription } : {}),
    ...(blogImage ? { "image": new URL(blogImage, site.domain).href } : {}),
    "url": new URL(Astro.url.pathname, site.domain).href,
    "mainEntityOfPage": { "@type": "WebPage", "@id": new URL(Astro.url.pathname, site.domain).href },
    ...data,
  });
}

if (type === 'AboutPage' || type === 'ContactPage' || type === 'CollectionPage') {
  schemas.push({
    "@context": "https://schema.org",
    "@type": type,
    "name": data.name || site.name,
    "url": new URL(Astro.url.pathname, site.domain).href,
    ...data,
  });
}

if (faqs && faqs.length > 0) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": { "@type": "Answer", "text": faq.answer },
    })),
  });
}
---
{schemas.map(schema => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
