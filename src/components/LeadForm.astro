---
import { services } from '../data/services';

interface Props {
  heading?: string;
  compact?: boolean;
}

const { heading = 'Request septic service', compact = false } = Astro.props;
const endpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT ?? '';
---
<div class:list={['lead-form', { compact }]} id="request-form">
  <div class="form-heading">
    <span class="section-label">{compact ? 'Fast, free estimate' : 'Takes about 60 seconds'}</span>
    <h2>{heading}</h2>
    <p>{compact ? 'Tell us what you need. We’ll follow up about your septic service.' : 'Share the essentials and we’ll follow up about the right septic service.'}</p>
  </div>

  <form id="contactForm" data-endpoint={endpoint} novalidate>
    <div class="form-grid">
      <div class="form-group">
        <label for="name">Your name <span>(required)</span></label>
        <input type="text" id="name" name="name" required autocomplete="name" placeholder="First and last name" />
        <small class="field-error" id="name-error"></small>
      </div>
      <div class="form-group">
        <label for="phone">Phone number <span>(required)</span></label>
        <input type="tel" id="phone" name="phone" required autocomplete="tel" inputmode="tel" placeholder="(713) 555-0123" aria-describedby="phone-help phone-error" />
        <small id="phone-help">Used only to follow up about this request.</small>
        <small class="field-error" id="phone-error"></small>
      </div>
    </div>

    <div class="form-group">
      <label for="service">What do you need? <span>(required)</span></label>
      <select id="service" name="service" required>
        <option value="">Choose the closest match</option>
        {services.map(service => <option value={service.name}>{service.name}</option>)}
        <option value="Not sure">I’m not sure yet</option>
      </select>
      <small class="field-error" id="service-error"></small>
    </div>

    {!compact && (
      <div class="form-group">
        <label for="message">Helpful details <span>(optional)</span></label>
        <textarea id="message" name="message" rows="4" placeholder="City, warning signs, and preferred timing"></textarea>
      </div>
    )}

    <div class="form-honeypot" aria-hidden="true">
      <label for="company">Company</label>
      <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
    </div>

    <button type="submit" class="btn-submit" id="submitBtn">
      <span class="btn-text">Send service request</span>
      <span class="btn-loading" hidden>Sending request…</span>
    </button>
    <p class="form-consent">Your details are used only to follow up about this service request. <a href="/privacy/">Privacy policy</a></p>
    <div class="form-status" id="formStatus" role="status" aria-live="polite" tabindex="-1"></div>
  </form>
</div>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const submitButton = document.getElementById('submitBtn') as HTMLButtonElement | null;
  const buttonText = submitButton?.querySelector('.btn-text') as HTMLElement | null;
  const buttonLoading = submitButton?.querySelector('.btn-loading') as HTMLElement | null;
  const status = document.getElementById('formStatus');

  const setError = (field: HTMLInputElement | HTMLSelectElement, message: string) => {
    const error = document.getElementById(`${field.id}-error`);
    field.setAttribute('aria-invalid', String(Boolean(message)));
    if (message) field.setAttribute('aria-describedby', `${field.id}-error`);
    else if (field.id !== 'phone') field.removeAttribute('aria-describedby');
    if (error) error.textContent = message;
  };

  const validate = () => {
    if (!form) return false;
    const name = form.elements.namedItem('name') as HTMLInputElement;
    const phone = form.elements.namedItem('phone') as HTMLInputElement;
    const service = form.elements.namedItem('service') as HTMLSelectElement;
    setError(name, name.value.trim() ? '' : 'Enter your name.');
    setError(phone, phone.value.replace(/\D/g, '').length >= 10 ? '' : 'Enter a valid phone number.');
    setError(service, service.value ? '' : 'Choose a service or select “I’m not sure yet.”');
    return [name, phone, service].every(field => field.getAttribute('aria-invalid') !== 'true');
  };

  form?.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input[required], select[required]').forEach(field => {
    field.addEventListener('blur', validate);
    field.addEventListener('input', () => {
      if (field.getAttribute('aria-invalid') === 'true') validate();
    });
  });

  form?.addEventListener('submit', async event => {
    event.preventDefault();
    status?.classList.remove('success', 'error');
    if (!validate()) {
      status!.textContent = 'Please review the highlighted fields.';
      status?.classList.add('error');
      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      return;
    }

    const endpoint = form.dataset.endpoint;
    if (!endpoint) {
      status!.textContent = 'Online requests are not connected yet. Please check back shortly.';
      status?.classList.add('error');
      status?.focus();
      return;
    }

    submitButton?.setAttribute('disabled', '');
    if (buttonText) buttonText.hidden = true;
    if (buttonLoading) buttonLoading.hidden = false;

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      if (!response.ok) throw new Error('Request failed');
      form.reset();
      status!.textContent = 'Request received. We’ll follow up about the next step.';
      status?.classList.add('success');
    } catch {
      status!.textContent = 'We could not send your request. Please try again in a moment.';
      status?.classList.add('error');
    } finally {
      submitButton?.removeAttribute('disabled');
      if (buttonText) buttonText.hidden = false;
      if (buttonLoading) buttonLoading.hidden = true;
      status?.focus();
    }
  });
</script>
