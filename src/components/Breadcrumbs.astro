---
interface Crumb {
  name: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": crumbs.map((crumb, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": crumb.name,
    ...(crumb.href ? { "item": new URL(crumb.href, 'https://septictankrepairhouston.com').href } : {}),
  })),
};
---
<nav class="breadcrumbs container" aria-label="Breadcrumb">
  <ol>
    {crumbs.map((crumb, i) => (
      <li>
        {i > 0 && <span class="breadcrumb-separator" aria-hidden="true">/</span>}
        {crumb.href ? (
          <a href={crumb.href}>{crumb.name}</a>
        ) : (
          <span class="breadcrumb-current" aria-current="page">{crumb.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
