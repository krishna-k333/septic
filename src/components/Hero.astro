---
interface Props {
  h1: string;
  lead: string;
}

const { h1, lead } = Astro.props;
---
<section class="hero">
  <div class="container">
    <h1>{h1}</h1>
    <p class="lead">{lead}</p>
    <div class="cta-group">
      <a href="/contact/" class="btn-hero">Get Free Estimate</a>
      <a href="/services/" class="btn-hero-outline">View Services</a>
    </div>
  </div>
</section>
