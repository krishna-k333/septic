---
interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = 'Need Septic Service in Houston?',
  text = 'Licensed, insured, and available 24/7 for emergencies. Free estimates for every job.',
} = Astro.props;
---
<section class="cta-band">
  <div class="container">
    <h2>{heading}</h2>
    <p>{text}</p>
    <a href="/contact/" class="btn-hero">Get Free Estimate</a>
  </div>
</section>
