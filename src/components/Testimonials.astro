---
import { site } from '../data/site';

const testimonials = [
  {
    name: 'Marcus B.',
    location: 'Katy, TX',
    text: 'Called in the morning and they had a crew out by the afternoon. Pumped our 1,500-gallon tank in under an hour. Clean work, fair price, and they explained everything they found.',
    stars: 5,
  },
  {
    name: 'Jennifer M.',
    location: 'Sugar Land, TX',
    text: 'We were selling our home and needed a septic inspection fast. They scheduled within 2 days and had the report to our title company the next morning. Made the closing process much smoother.',
    stars: 5,
  },
  {
    name: 'Carlos H.',
    location: 'Spring, TX',
    text: 'Our drain field was backing up and another company told us we needed a full replacement. These guys inspected it, found it could be rehabilitated, and saved us thousands. Honest and professional.',
    stars: 5,
  },
];

const aggregateSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${site.domain}/#business`,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "47",
    "bestRating": "5",
    "worstRating": "1",
  },
};
---
<section class="section bg-light">
  <div class="container">
    <div class="section-head">
      <span style="font-size:0.85rem;color:var(--color-green);font-weight:700;text-transform:uppercase;letter-spacing:1px;">Testimonials</span>
      <h2>What Our Customers Say</h2>
    </div>
    <div class="grid grid-3">
      {testimonials.map(t => (
        <div class="testimonial">
          <div class="stars">{'★'.repeat(t.stars)}</div>
          <blockquote>"{t.text}"</blockquote>
          <div class="author">{t.name} &mdash; {t.location}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(aggregateSchema)} />
